model {
  extend keelWeb {
    server = container 'Web server' {
      description 'Hono server that streams Claude Code output to the client and reads tickets and pull requests from the trackers'
      technology 'TypeScript, Hono, Node'

      app = component 'HTTP app' {
        description 'Hono application that mounts middleware, serves the health endpoint and starts the Node server'
        technology 'Hono, @hono/node-server'
        link ../../keel-web/server/src/index.ts
      }

      workspaces = component 'Workspace registry' {
        description 'Resolves a workspace to the repository it stands for, the keel configuration in it and whether it can hold a session'
        link ../../keel-web/server/src/workspaces/types.ts
      }

      workspaceStore = component 'Remembered workspaces' {
        description 'Reads and writes the developer\'s list of added repositories in their configuration directory'
        link ../../keel-web/server/src/workspaces/types.ts
      }

      directories = component 'Directory browser' {
        description 'Lists the subdirectories of a path on this machine, so a repository can be picked instead of typed'
        link ../../keel-web/server/src/directories/types.ts
      }

      workspaceApi = component 'Workspace API' {
        description 'Serves the workspaces to the browser and takes the ones the developer adds and removes'
        technology 'Hono'
        link ../../keel-web/server/src/workspaces/types.ts
      }

      chatApi = component 'Chat API' {
        description 'Streams session events to the browser and takes messages, permission answers and interrupts'
        technology 'Hono, Server-Sent Events'
        link ../../keel-web/server/src/chat/types.ts
      }

      sessions = component 'Session registry' {
        description 'Owns one resumable Claude Code session per workspace and ticket, its attached viewers and its pending permission requests'
        technology 'Claude Agent SDK'
        link ../../keel-web/server/src/sessions/types.ts
      }

      permissionGate = component 'Permission gate' {
        description 'Holds every tool call until the browser has answered, so nothing runs unapproved'
        technology 'Claude Agent SDK hooks'
        link ../../keel-web/server/src/permissions/types.ts
      }

      transcript = component 'Transcript log' {
        description 'Appends normalised wire events with sequence numbers into the workspace ticket repository and replays them to a returning viewer'
        link ../../keel-web/server/src/transcript/types.ts
      }

      logger = component 'Logger' {
        description 'Shared structured logger and request-logging middleware, pretty in development and JSON in production'
        technology 'pino'
        link ../../keel-web/server/src/logging/types.ts
      }

      app -> logger 'Mounts request logging and logs startup'
      app -> chatApi 'Mounts the chat routes'
      app -> workspaceApi 'Mounts the workspace routes'
      app -> directories 'Mounts the directory route'
      workspaceApi -> workspaces 'Lists the workspaces and adds or removes one'
      workspaces -> workspaceStore 'Reads the remembered list and records an addition or a removal'
      chatApi -> workspaces 'Resolves the workspace a request names'
      chatApi -> sessions 'Attaches viewers, forwards messages, answers and interrupts'
      chatApi -> transcript 'Replays events from the last delivered sequence number'
      sessions -> workspaces 'Reads the repository an agent runs in'
      sessions -> transcript 'Appends normalised events'
      sessions -> logger 'Logs session lifecycle outside any request'
      sessions -> permissionGate 'Holds each tool call until the browser answers'
      transcript -> workspaces 'Resolves the ticket repository the record is written into'
    }

    server -> ticketTrackers 'Reads tickets and pull requests' {
      #planned
    }
  }

  keelWeb.server.sessions -> claudeCode 'Runs a resumable session per ticket through the Agent SDK'
  claudeCode -> keelWeb.server.sessions 'Asks before it runs a tool'
}
