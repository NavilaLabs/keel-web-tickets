model {
  extend keelWeb {
    client = container 'Web client' {
      description 'Vite and React single-page app rendering chat, view-only tickets and pull requests, LikeC4 diagrams and phase progress'
      technology 'TypeScript, React, Vite'

      shell = component 'App shell' {
        description 'Places the ticket list, the artifact area and the chat column, and keeps the selected ticket in the URL'
        technology 'React, Tailwind, shadcn/ui'
        link ../../keel-web/client/src/App.tsx
      }

      chat = component 'Chat surface' {
        description 'Renders the transcript, the streaming draft and the message input'
        link ../../keel-web/client/src/chat/types.ts
      }

      composer = component 'Composer' {
        description 'Takes the message the developer writes, completes a slash command or a file reference in it, and keeps the unsent draft and what was sent before'
        link ../../keel-web/client/src/composer/types.ts
      }

      permissionPrompt = component 'Permission prompt' {
        description 'Shows a held tool call with its input and takes the developer answer, for this one call or for the rest of the session'
        link ../../keel-web/client/src/chat/types.ts
      }

      questionPrompt = component 'Question prompt' {
        description 'Shows what the agent is asking and takes the answer, one question at a time when there are several of them'
        link ../../keel-web/client/src/questions/types.ts
      }

      sessionControls = component 'Session controls' {
        description 'Holds the model, the mode, the effort and the commands a session offers, and takes the developer\'s change to any of them'
        link ../../keel-web/client/src/session-controls/types.ts
      }

      transcriptStore = component 'Transcript store' {
        description 'Holds the recorded events and the live draft, and folds them into what the chat renders'
        link ../../keel-web/client/src/transcript/types.ts
      }

      connection = component 'Session connection' {
        description 'Opens the event stream and posts messages, permission answers, interrupts and changes to what the session runs with'
        technology 'EventSource, fetch'
        link ../../keel-web/client/src/connection/types.ts
      }

      router = component 'Router' {
        description 'Keeps the selected workspace, ticket and open artefact in the URL and reports when it changes'
        link ../../keel-web/client/src/routing/types.ts
      }

      directoryPicker = component 'Directory picker' {
        description 'Walks the directories on this machine in a dialog, so a repository is chosen rather than typed'
        link ../../keel-web/client/src/directories/types.ts
      }

      workspaceList = component 'Workspace list' {
        description 'Holds the repositories for the sidebar and adds or removes one at the developer\'s request'
        link ../../keel-web/client/src/workspaces/types.ts
      }

      centre = component 'Centre area' {
        description 'Keeps the artefacts the developer opened for a ticket as tabs and shows one of them'
        link ../../keel-web/client/src/artifacts/types.ts
      }

      artifactTree = component 'Artefact tree' {
        description 'Lists the artefacts of a ticket so the developer reaches any of them without asking the agent'
        link ../../keel-web/client/src/artifacts/types.ts
      }

      artifactView = component 'Artefact view' {
        description 'Renders one artefact as its kind deserves and says when a stub has drifted from the contract that was frozen'
        link ../../keel-web/client/src/artifacts/types.ts
      }

      hintListener = component 'Hint listener' {
        description 'Listens for what the workflow says is worth looking at and brings it to the front once'
        technology 'EventSource'
        link ../../keel-web/client/src/hints/types.ts
      }

      architecturePane = component 'Architecture pane' {
        description 'Reads one laid-out view for a workspace and branch and hands it to the diagram to draw'
        link ../../keel-web/client/src/architecture/architecture-pane.tsx
      }

      diagramView = component 'Diagram view' {
        description 'Renders one laid-out architecture view and reports the element or link the developer follows'
        technology 'likec4'
        link ../../keel-web/client/src/architecture/types.ts
      }

      shell -> chat 'Keeps the chat beside the ticket list and the artifact area'
      shell -> centre 'Gives the centre the room the sidebar leaves once a ticket is selected'
      centre -> artifactTree 'Lists what can be opened and takes what the developer picked'
      centre -> artifactView 'Shows the artefact of the active tab'
      artifactView -> architecturePane 'Hands a view reference over to be read and drawn'
      architecturePane -> diagramView 'Gives the laid-out view to the diagram, loaded on first use'
      shell -> hintListener 'Opens what the workflow points at, and lets the developer override it'
      shell -> router 'Reads the selected workspace and ticket, and navigates'
      shell -> workspaceList 'Lists the repositories to pick from, and adds or removes one'
      shell -> directoryPicker 'Opens the picker and takes the directory it returns'
      shell -> transcriptStore 'Points the store at the selected ticket'
      shell -> connection 'Builds the connection the store runs on'
      chat -> transcriptStore 'Reads the transcript and sends messages, answers and interrupts'
      chat -> permissionPrompt 'Shows a held tool call in place'
      chat -> questionPrompt 'Shows a question the agent asked in place'
      chat -> composer 'Takes the message the developer writes, and hands it the commands to complete'
      chat -> sessionControls 'Shows what the session runs with under the input, and changes it'
      shell -> sessionControls 'Builds the store the one stream feeds'
      shell -> composer 'Builds the book the unsent draft and the history live in'
      sessionControls -> connection 'Posts a change to what the session runs with'
      transcriptStore -> connection 'Opens the stream and posts commands'
      transcriptStore -> sessionControls 'Passes on what the one stream says the session runs with'
    }
  }

  keelWeb.client.connection -> keelWeb.server.chatApi 'Streams events and posts commands'
  keelWeb.client.workspaceList -> keelWeb.server.workspaceApi 'Reads the workspaces and adds or removes one'
  keelWeb.client.directoryPicker -> keelWeb.server.directories 'Reads the subdirectories of a path'
  keelWeb.client.composer -> keelWeb.server.fileApi 'Reads the files and directories an @ query matches'
  keelWeb.client.centre -> keelWeb.server.artifactApi 'Reads the artefact tree and the open artefact, and asks again with its entity tag'
  keelWeb.client.architecturePane -> keelWeb.server.architecture 'Reads the laid-out model of a view on a branch'
  keelWeb.client.hintListener -> keelWeb.server.hints 'Subscribes to the hints of a ticket, from now on'
}
